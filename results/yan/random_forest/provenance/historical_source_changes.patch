@@ -0,0 +1,587 @@
+"""Build RF-only review tables, figures and bilingual explanation after verification."""
+from pathlib import Path
+import json
+import time
+
+import matplotlib
+matplotlib.use("Agg")
+import matplotlib.pyplot as plt
+import numpy as np
+import pandas as pd
+from final_analysis import summarize_prediction_rows, MODEL_GRIDS
+from .audit import ROOT, MODEL, sha, write_json, align_reference, data_and_splits
+
+METRICS = ["auroc", "auprc", "brier_score", "log_loss", "sensitivity", "specificity",
+           "ppv", "npv", "FN", "FP", "TP", "TN", "mean_predicted", "observed_prevalence", "ece"]
+
+
+def save(fig, path):
+    fig.tight_layout()
+    fig.savefig(path, dpi=180, bbox_inches="tight")
+    plt.close(fig)
+
+
+def build_report(out):
+    tick = time.perf_counter()
+    verification = json.loads((out / "verification.json").read_text())
+    assert verification["complete"] and verification["all_required_checks_passed"]
+    manifest = json.loads((out / "run_manifest.json").read_text())
+    p = pd.read_csv(out / "oof_predictions.csv")
+    fold = pd.read_csv(out / "fold_results.csv")
+    search = pd.read_csv(out / "inner_cv_results.csv")
+    reps = pd.read_csv(out / "repeat_metrics.csv")
+    summary = pd.read_csv(out / "summary_metrics.csv").set_index("metric")
+    cal = pd.read_csv(out / "calibration_points.csv")
+    importance = pd.read_csv(out / "feature_importances.csv")
+    figures = out / "figures"
+    figures.mkdir(exist_ok=True)
+    plt.rcParams.update({"font.size": 10, "axes.spines.top": False,
+                         "axes.spines.right": False, "figure.facecolor": "white"})
+
+    # Only existing compatible ridge predictions are read; no regression fit occurs.
+    _, outer, _ = data_and_splits()
+    reference = ROOT / "results/final_nested/predictions/Ridge_Logistic.csv"
+    paired = pd.DataFrame()
+    reference_summary = None
+    if reference.exists():
+        ref = align_reference(pd.read_csv(reference), outer, "Ridge_Logistic")
+        align_reference(p, outer, MODEL)
+        ref_reps = pd.DataFrame([dict(repeat=int(r), model="Ridge_Logistic",
+            **summarize_prediction_rows(g)) for r, g in ref.groupby("repeat")])
+        ref_reps.to_csv(out / "comparator_repeat_metrics.csv", index=False)
+        merged = reps.merge(ref_reps, on="repeat", suffixes=("_rf", "_ridge"), validate="one_to_one")
+        paired = pd.DataFrame(dict(repeat=merged["repeat"], model=MODEL, comparator="Ridge_Logistic",
+            **{m + "_difference": merged[m + "_rf"] - merged[m + "_ridge"] for m in METRICS}))
+        paired.to_csv(out / "paired_repeat_differences.csv", index=False)
+        dcols = [c for c in paired if c.endswith("_difference")]
+        paired_summary = paired[dcols].agg(["mean", "std", "min", "max"]).T.reset_index(names="metric")
+        paired_summary.to_csv(out / "paired_difference_summary.csv", index=False)
+        reference_summary = ref_reps[METRICS].mean()
+
+    # Selection counts describe decisions made on inner data, never outer-score selection.
+    selected = fold.copy()
+    parsed = pd.json_normalize(selected.params_json.map(json.loads))
+    selected = pd.concat([selected, parsed], axis=1)
+    selected["depth_label"] = selected.max_depth.map(lambda v: "None" if pd.isna(v) else str(int(v)))
+    selected["features_label"] = selected.max_features.astype(str)
+    selected["leaf_label"] = selected.min_samples_leaf.astype(int).astype(str)
+    selection = pd.DataFrame(dict(candidate=k, params_json=json.dumps(v, sort_keys=True, separators=(",", ":")))
+                             for k, v in enumerate(MODEL_GRIDS[MODEL]))
+    counts = selected.params_json.value_counts()
+    selection["selected_folds"] = selection.params_json.map(counts).fillna(0).astype(int)
+    selection = selection.sort_values(["selected_folds", "params_json"], ascending=[False, True])
+    selection.to_csv(out / "parameter_selection.csv", index=False)
+    inner_summary = search.groupby(["candidate", "params_json"]).mean_inner_auroc.agg(
+        ["mean", "std", "min", "max"]).reset_index()
+    inner_summary.to_csv(out / "inner_parameter_summary.csv", index=False)
+    imp_summary = importance.groupby("feature").importance.agg(["mean", "std", "min", "max"]).reset_index()
+    imp_summary = imp_summary.sort_values("mean", ascending=False)
+    imp_summary.to_csv(out / "feature_importance_summary.csv", index=False)
+    importance["family"] = importance.feature.str.rsplit("_", n=1).str[0]
+    family = importance.groupby(["repeat", "fold", "family"]).importance.sum().reset_index()
+    family_summary = family.groupby("family").importance.agg(["mean", "std", "min", "max"]).reset_index()
+    family_summary.sort_values("mean", ascending=False).to_csv(out / "feature_family_summary.csv", index=False)
+    family.to_csv(out / "feature_family_importances.csv", index=False)
+
+    fig, axes = plt.subplots(2, 2, figsize=(10, 6))
+    for ax, metric, label in zip(axes.flat, ["auroc", "brier_score", "sensitivity", "specificity"],
+                                 ["AUROC", "Brier score (lower is better)", "Sensitivity", "Specificity"]):
+        ax.plot(reps["repeat"], reps[metric], marker="o", color="#2878B5")
+        if metric == "sensitivity":
+            ax.axhline(.95, color="gray", linestyle="--", label="Training target")
+            ax.legend(fontsize=8)
+        ax.set(xlabel="Repeat", ylabel=label, xticks=range(1, 11))
+        ax.grid(alpha=.2)
+    fig.suptitle("Random Forest: pooled outer predictions within each repeat", y=1.02)
+    save(fig, figures / "repeat_metrics.png")
+
+    fig, ax = plt.subplots(figsize=(7, 5))
+    for repeat, group in cal.groupby("repeat"):
+        ax.plot(group.mean_probability, group.observed_fraction, "o-", alpha=.65,
+                linewidth=1, markersize=3, label=f"Repeat {repeat}")
+    ax.plot([0, 1], [0, 1], "--", color="black", label="Ideal")
+    ax.set(xlabel="Mean predicted malignancy probability", ylabel="Observed malignant fraction",
+           title="Calibration: separate quantile bins for each repeat",
+           xlim=(-.02, 1.02), ylim=(-.02, 1.02))
+    ax.legend(ncol=2, fontsize=8)
+    ax.grid(alpha=.2)
+    save(fig, figures / "calibration.png")
+
+    fig, axes = plt.subplots(1, 2, figsize=(10, 4))
+    index = np.arange(1, 51)
+    axes[0].plot(index, fold.train_resubstitution_auroc, ".", label="Training (optimistic)")
+    axes[0].plot(index, fold.validation_auroc, ".", label="Outer validation")
+    axes[0].set(xlabel="Outer fit (repeat, then fold)", ylabel="AUROC",
+                title="Training and validation scores")
+    axes[0].legend(fontsize=8)
+    axes[1].hist(fold.training_validation_gap, bins=12, color="#2878B5", edgecolor="white")
+    axes[1].set(xlabel="Training AUROC minus validation AUROC", ylabel="Outer fits",
+                title="Diagnostic only; no retuning")
+    save(fig, figures / "training_validation_gap.png")
+
+    fig, axes = plt.subplots(1, 3, figsize=(10, 3.5))
+    marginal_rows = []
+    for ax, column, title, levels in zip(axes, ["depth_label", "leaf_label", "features_label"],
+                                ["max_depth", "min_samples_leaf", "max_features"],
+                                [["3", "None"], ["1", "3", "5", "10"], ["sqrt", "0.5"]]):
+        counts = selected[column].value_counts().reindex(levels, fill_value=0)
+        marginal_rows.extend(dict(parameter=title, value=k, selected_folds=int(v))
+                             for k, v in counts.items())
+        ax.bar(counts.index, counts.values, color="#2878B5")
+        ax.set(xlabel=title, ylabel="Selected outer fits", ylim=(0, 50))
+        for j, n in enumerate(counts.values):
+            ax.text(j, n+.7, str(n), ha="center")
+    fig.suptitle("Parameter selection across 50 outer-training sets", y=1.02)
+    save(fig, figures / "parameter_selection.png")
+    pd.DataFrame(marginal_rows).to_csv(out / "parameter_selection_marginals.csv", index=False)
+
+    params = pd.json_normalize(search.params_json.map(json.loads))
+    inner_plot = pd.concat([search.reset_index(drop=True), params], axis=1)
+    inner_plot["depth_label"] = inner_plot.max_depth.map(lambda v: "None" if pd.isna(v) else str(int(v)))
+    fig, axes = plt.subplots(1, 2, figsize=(10, 4), sharey=True)
+    effects = []
+    for ax, feature_setting in zip(axes, ["sqrt", 0.5]):
+        sub = inner_plot.loc[inner_plot.max_features.eq(feature_setting)]
+        for depth, group in sub.groupby("depth_label"):
+            g = group.groupby("min_samples_leaf").mean_inner_auroc.agg(["mean", "std"])
+            ax.errorbar(g.index, g["mean"], yerr=g["std"], marker="o", capsize=3,
+                        label=f"depth={depth}")
+            effects.extend(dict(max_features=feature_setting, max_depth=depth,
+                min_samples_leaf=int(k), mean=float(v["mean"]), std=float(v["std"]))
+                for k, v in g.iterrows())
+        ax.set(xlabel="min_samples_leaf", ylabel="Mean inner-fold AUROC",
+               title=f"max_features={feature_setting}", xticks=[1, 3, 5, 10])
+        ax.legend(fontsize=8)
